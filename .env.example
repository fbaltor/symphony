# ─── Required ────────────────────────────────────────────────────────────────

# Linear API token (Personal API key like `lin_api_*`, OR a Bearer OAuth token).
# Used both for the orchestrator's GraphQL polling AND the agent's Linear MCP.
# Personal API keys are sent bare; OAuth/PAT tokens auto-prefixed with `Bearer `.
LINEAR_API_KEY=

# Anthropic API key consumed by the Claude AgentRunner adapter (sk-ant-*).
ANTHROPIC_API_KEY=

# Optional Cloudflare AI Gateway routing. When set, the Claude Agent SDK's
# underlying Anthropic client routes through the gateway instead of
# api.anthropic.com directly. Format:
#   https://gateway.ai.cloudflare.com/v1/<account_id>/symphony/anthropic
# Benefits: per-tenant attribution, request caching dashboards, spend visibility
# distinct from raw Anthropic usage. Leave unset to call Anthropic directly.
ANTHROPIC_BASE_URL=

# Postgres URL for audit/budget/instance-lock tables.
# Example: postgresql://USER:PASS@127.0.0.1:5432/mydb
DATABASE_URL=

# ─── Optional — Slack thread observer ────────────────────────────────────────

# Both must be set to enable threaded Slack lifecycle cards. Omit either to
# silently disable the SlackObserver (Symphony itself keeps running).
# Bot token starts with `xoxb-`; channel id like `C0123456789` (NOT the name).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ─── Optional — agent MCP credentials ────────────────────────────────────────

# Slack MCP (npm package @modelcontextprotocol/server-slack). When SLACK_BOT_TOKEN
# is set, the MCP is enabled; SLACK_TEAM_ID is forwarded to the MCP subprocess.
SLACK_TEAM_ID=

# Notion MCP (https://mcp.notion.com/mcp). Token format: `ntn_*` integration token.
NOTION_TOKEN=

# Sentry MCP (npm package @sentry/mcp-server).
# Both SENTRY_AUTH_TOKEN and SENTRY_ORG must be set to enable the Sentry MCP.
# SENTRY_ORG is your Sentry organization slug (e.g. "my-company").
SENTRY_AUTH_TOKEN=
SENTRY_ORG=

# ─── Optional — GitHub App (used for git clone in workspace hooks + GitHub MCP) ──

# Symphony mints short-lived installation tokens at runtime from these three
# creds (see src/lib/github-auth.ts). When any are absent, hooks that need
# GITHUB_TOKEN (`before_run` clone) will fail and the GitHub MCP is skipped.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM with literal `\n` sequences OR real newlines — both accepted (normalized
# in lib/github-auth.ts#normalizePrivateKey).
GITHUB_APP_PRIVATE_KEY=

# ─── Optional — runtime knobs ────────────────────────────────────────────────

# Override of WORKFLOW.md path. Defaults to ./WORKFLOW.md (CWD) — but in
# production (Dockerfile sets it to /app/WORKFLOW.md) the env var is set.
SYMPHONY_WORKFLOW_PATH=

# pino log level. trace|debug|info|warn|error|fatal. Default: info. Production
# Cloud Run runs with NODE_ENV=production so the JSON formatter activates.
LOG_LEVEL=info

# HTTP server port for /health, /status, /cost. Default 8080.
# Cloud Run injects $PORT itself; setting this here is for local dev.
PORT=

# Postgres schema name appended to DATABASE_URL via the libpq `options` startup
# parameter (audit/client.ts). Default: `symphony`. Override only if running
# against a non-standard schema in a shared instance.
DB_SCHEMA=

# Graceful drain timeout (ms) before SIGKILL on shutdown.
# Default: 540000 (9 min). main.ts clamps invalid values to the default.
SYMPHONY_DRAIN_TIMEOUT_MS=

# ─── Auto-injected (do not set manually) ─────────────────────────────────────
#
# K_REVISION       — Cloud Run sets this; consumed by singleton/instance-lock.ts
#                    to derive the human-readable instance ID.
# NODE_ENV         — Dockerfile / infra/index.ts set this; controls pino transport.
# CLAUDE_AGENT_SDK_CLIENT_APP — main.ts sets this at boot (BEFORE the SDK
#                    module loads) to `symphony/<version>+<gitSha>` so
#                    Anthropic per-request usage logs can be filtered
#                    by build identifier. Override only if you intentionally
#                    want a different tag (e.g. local-dev distinct from prod).
